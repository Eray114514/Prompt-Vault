# ============================================================
# Prompt Vault 环境变量模板
# 复制为 .env.local 后填入真实值：cp .env.example .env.local
# 本文件只放占位值，绝不要提交真实密钥（仓库是公开的）。
# ============================================================

# ---- Supabase ----
# 从 Supabase Dashboard -> Project Settings -> API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 可选：服务端改用 service_role key（它同样只在服务端使用，不会进浏览器包）。
# 配合"开启 RLS 且不写任何策略"，即使 anon key 将来外泄也读不到数据。
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- 前端登录 ----
# 全站访问密码。缺失时站点 fail-closed —— 谁都进不去，这是刻意设计。
APP_PASSWORD=change-me

# 会话 cookie 的签名密钥。建议用随机值；不设则回退用 APP_PASSWORD。
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---- 写接口 ----
# POST /api/prompts 的 Bearer 密钥。
# GET 是公开的，不需要这个；未设置时写接口直接返回 503，不会退化成无鉴权可写。
API_SECRET=

# ---- 导出 / 备份 ----
# GET /api/export 是整库 dump，接受 API_SECRET 或 CRON_SECRET 中任意一个。
# 两个都未配置时导出端点返回 503（绝不公开）。
# CRON_SECRET 只在用 Vercel Cron 触发时才需要 —— 设置后 Vercel 会自动带上
# Authorization: Bearer <CRON_SECRET>。本机定时任务用 API_SECRET 即可，不必配这个。
CRON_SECRET=
